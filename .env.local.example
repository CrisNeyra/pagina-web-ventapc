# --- Stack: Next.js + Prisma + Neon (sin Docker / sin Nest) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JWT para login/registro (Route Handlers en /api/auth/*). Secreto largo (≥32).
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio

# Seed admin (obligatorio). Mín. 10 caracteres, letra y número.
ADMIN_EMAIL=admin@aurapro.com
ADMIN_PASSWORD=

# Mercado Pago Checkout Pro (débito/crédito vía /api/payments/mercadopago/*)
# Usá credenciales de PRUEBA. Guía: docs/mercadopago.md
# Si un token se filtró en un chat, regeneralo en MP y reemplazá aquí y en Vercel.
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-... o TEST-...
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-... o TEST-...
# Clave secreta del webhook (panel MP → Webhooks). Sin esto el aviso se procesa igual.
# MERCADOPAGO_WEBHOOK_SECRET=
# Webhook: panel MP (no abrir la URL en el browser) → https://TU-DOMINIO/api/payments/mercadopago/webhook

# Emails (Resend). Sin estas dos, en local el modal muestra el enlace de restablecer.
# Para probar: remitente onboarding@resend.dev (solo llega a la casilla de la cuenta Resend).
# Para clientes reales: verificá un dominio y usá un remitente de ese dominio.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Aura Pro <onboarding@resend.dev>

# CVs en Vercel (Blob). Sin esto, se usa carpeta local uploads/ (solo dev).
# BLOB_READ_WRITE_TOKEN=

# Rate limit compartido. Preferido: Redis Cloud (gratis) → https://app.redislabs.com
# Tras crear la DB, copiá Public endpoint + Default user password y armá:
# REDIS_URL=redis://default:PASSWORD@HOST:PORT
# Si Redis Cloud pide TLS: REDIS_URL=rediss://... o REDIS_TLS=true con host/password.
# O por partes:
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
# REDIS_USERNAME=default
# REDIS_TLS=true
# Alternativa Upstash REST (opcional):
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Emails admin extra
# ADMIN_EMAILS=admin@aurapro.com

# URL pública del sitio (también es el origen del redirect de Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login con Google. El redirect usa el origen de la visita.
# Registrá ambos en Google Cloud → URI de redireccionamiento:
# http://localhost:3000/api/auth/google/callback
# https://pagina-web-ventapc.vercel.app/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Vercel Cron (/api/cron/reservas) libera stock de efectivo a las 48 h.
# En plan Hobby: como máximo 1 vez al día (ej. 0 6 * * *). Horario = UTC.
# CRON_SECRET=

# Observabilidad
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Asesor de catálogo (Gemini). Solo servidor. Sin esta key el chat dice que no está configurado.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
