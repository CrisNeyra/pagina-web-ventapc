# --- Stack: Next.js + Prisma + Neon (sin Docker / sin Nest) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JWT para login/registro (Route Handlers en /api/auth/*). Secreto largo (≥32).
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio

# Seed admin (obligatorio). Mín. 10 caracteres, letra y número.
ADMIN_EMAIL=admin@aurapro.com
ADMIN_PASSWORD=

# Stripe (débito/crédito vía /api/payments/stripe/*)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_INSTALLMENTS=true

# Emails (Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Aura Pro <hola@tudominio.com>

# CVs en Vercel (Blob). Sin esto, se usa carpeta local uploads/ (solo dev).
# BLOB_READ_WRITE_TOKEN=

# Rate limit en Vercel (recomendado)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Emails admin extra
# ADMIN_EMAILS=admin@aurapro.com

# URL pública del sitio (también es el origen del redirect de Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login con Google. El redirect usa el origen de la visita.
# Registrá ambos en Google Cloud → URI de redireccionamiento:
# http://localhost:3000/api/auth/google/callback
# https://pagina-web-ventapc.vercel.app/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Vercel Cron (/api/cron/reservas) libera stock de efectivo a las 48 h.
# En plan Hobby: como máximo 1 vez al día (ej. 0 6 * * *). Horario = UTC.
# CRON_SECRET=

# Observabilidad
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# --- Legacy opcional: Nest externo (carpeta api/, archivada) ---
# NEXT_PUBLIC_API_URL=https://TU-DOMINIO.up.railway.app/api
