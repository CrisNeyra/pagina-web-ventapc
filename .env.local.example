# --- Stack: Next.js + Prisma + Neon (sin Docker / sin Nest) ---
# Creá un proyecto en https://console.neon.tech y pegá la connection string:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JWT para login/registro (Route Handlers en /api/auth/*). Usá un secreto largo.
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio

# Stripe (débito/crédito vía /api/payments/stripe/*)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Emails admin (opcional; además del rol admin en DB)
# ADMIN_EMAILS=admin@aurapro.com

# Carpeta local de CVs (default: uploads/)
# UPLOADS_DIR=uploads

# URL pública del sitio (útil en deploy / Server Components)
# NEXT_PUBLIC_SITE_URL=https://pagina-web-ventapc.vercel.app

# Observabilidad (opcional)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# --- Legacy opcional: Nest externo (carpeta api/) ---
# Solo si querés forzar el cliente a pegarle a Nest en vez de /api de Next.
# Ya no hace falta para el flujo diario: pedidos, Stripe, admin, builds y postulaciones están en Next.
# NEXT_PUBLIC_API_URL=https://TU-DOMINIO.up.railway.app/api
# NEXT_PUBLIC_USE_API_CATALOG=true
