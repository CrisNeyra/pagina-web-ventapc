# Copiá a .env y ajustá valores
DATABASE_URL=postgresql://aurapro:aurapro_dev@localhost:5432/aurapro?schema=public
# Opcional (sin REDIS_URL el health sigue OK si hay Postgres)
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev_jwt_secret_change_in_production
PORT=4000
CORS_ORIGINS=http://localhost:3000,https://pagina-web-ventapc.vercel.app

ADMIN_EMAILS=admin@aurapro.com
# ADMIN_EMAIL=admin@aurapro.com
# ADMIN_PASSWORD=1234ab

# Emails (opcional — Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Aura Pro <onboarding@resend.dev>
# PUBLIC_SITE_URL=https://pagina-web-ventapc.vercel.app

# Stripe (opcional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Storage CVs: sin MINIO_ENDPOINT = carpeta local uploads/
# UPLOADS_DIR=uploads
# MinIO / S3 (opcional)
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=aurapro
# MINIO_USE_SSL=false

# Cloud (Neon + Railway): ver docs/demo-cloud.md
# Seguridad: docs/seguridad-api.md
