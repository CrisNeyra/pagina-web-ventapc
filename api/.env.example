# Copiá a .env y ajustá valores
DATABASE_URL=postgresql://aurapro:aurapro_dev@localhost:5432/aurapro?schema=public
# Opcional en demo cloud (sin REDIS_URL el health sigue OK si hay Postgres)
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev_jwt_secret_change_in_production
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Admin (emails con rol admin en seed / exchange)
ADMIN_EMAILS=admin@aurapro.com

# Firebase Admin (solo para firebase-exchange y migración de usuarios)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Apagar el puente Firebase → JWT (demo Nest / producción)
# DISABLE_FIREBASE_EXCHANGE=true

# Stripe (opcional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# MinIO (opcional; sin esto fallan solo uploads de CV)
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=aurapro
# MINIO_USE_SSL=false

# --- Cloud demo (Neon + Railway) ---
# DATABASE_URL=postgresql://...@ep-xxxx.neon.tech/neondb?sslmode=require
# CORS_ORIGINS=https://pagina-web-ventapc.vercel.app,http://localhost:3000
# JWT_SECRET=generar_secreto_largo
# DISABLE_FIREBASE_EXCHANGE=true
# Ver docs/demo-cloud.md
