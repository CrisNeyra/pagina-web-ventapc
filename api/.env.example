# Copiá a .env y ajustá valores
DATABASE_URL=postgresql://aurapro:aurapro_dev@localhost:5432/aurapro?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev_jwt_secret_change_in_production
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Admin (emails con rol admin en seed / exchange)
ADMIN_EMAILS=admin@aurapro.com

# Firebase Admin (solo para firebase-exchange y migración de usuarios)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Apagar el puente Firebase → JWT (Fase B / producción Nest-only)
# DISABLE_FIREBASE_EXCHANGE=true

# Stripe (opcional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# MinIO (postulaciones CV)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurapro
MINIO_USE_SSL=false
